# Copy to server/.env for local development. Never commit .env.
# Local MongoDB, e.g.: docker run -d -p 27017:27017 mongo:7
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=focusdock_dev
# openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
PORT=8080
MIN_CLIENT=0.0.0
LATEST_CLIENT=0.1.0
