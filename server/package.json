{
  "name": "focusdock-server",
  "version": "0.1.0",
  "private": true,
  "description": "FocusDock sync API: accounts, wrapped vault keys and encrypted items in MongoDB.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/scripts/migrate.js",
    "test": "vitest run",
    "lint": "eslint .",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:shell": "docker compose exec mongo mongosh focusdock_dev"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "argon2": "^0.44.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "mongodb": "^6.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "vitest": "^3.2.7"
  }
}
